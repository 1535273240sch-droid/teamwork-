{
  "description": "Teamwork - exclusive file ownership and campaign context",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/session-context.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "Loading Teamwork charter..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/ownership-lock.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "Checking file ownership..."
          }
        ]
      }
    ]
  }
}
